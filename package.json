    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "1.56.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.2.9",
    "typescript": "^6.0.0",
    "vitest": "^4.1.0"
  }
}
